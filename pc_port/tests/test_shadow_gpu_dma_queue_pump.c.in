int PE_MMIO_InShadowBlock(pe_addr_t a, size_t n) { (void)a; (void)n; return 0; }
void *PE_MMIO_Translate(pe_addr_t a, size_t n) { (void)a; (void)n; abort(); }
uint32_t PE_MMIO_Load(pe_addr_t a, size_t n)
{
    if(a==0x1f8010f4u && n==4) return PE_GPU_ReadDICR();
    if(n!=2) abort();
    if(a==0x1f801070u) return PE_IRQ_ReadStatus();
    if(a==0x1f801074u) return PE_IRQ_GetMask();
    abort();
}
void PE_MMIO_Store(pe_addr_t a, size_t n, uint32_t v)
{
    if(a==0x1f8010f4u && n==4) { PE_IRQ_ObserveDicrWrite(v); PE_GPU_WriteDICR(v); return; }
    if(n!=2) abort();
    if(a==0x1f801070u) { PE_IRQ_ObserveIstatWrite((uint16_t)v); PE_IRQ_WriteStatus((uint16_t)v); return; }
    if(a==0x1f801074u) { PE_IRQ_ExchangeMask((uint16_t)v); return; }
    abort();
}
void PE_MDEC_GetState(PeMdecState *out) { (void)out; abort(); }
uint32_t PE_CdReg_ReadU32(pe_addr_t address) { (void)address; abort(); }
pe_addr_t PE_SpuDma_ReadMADR(void) { abort(); }
int PE_Irq_LockDepth(void) { return 0; }
unsigned PE_Port_StopEpoch(void) { return 0; }
void Bootstrap_ReturnVoid(const char *a,const char *b) { (void)a;(void)b;abort(); }
int32_t PE_Bios_Printf(pe_addr_t a,const uint32_t *b,int c) { (void)a;(void)b;(void)c;abort(); }
static unsigned dma_callback_calls;
int PE_Port_ShouldStop(void) { return 0; }
static PeGpuPumpTrace pump_trace;
static uint64_t pump_order;
static unsigned pump_entries, worker_calls;
PeGpuPumpTrace *pe_plat_pump_trace_existing(void) { return &pump_trace; }
void pe_plat_pump_enter_existing(void) { pump_entries++; }
uint64_t pe_plat_pump_next_existing(void) { return ++pump_order; }
uint16_t pe_plat_irq_set_mask(uint16_t mask) { return PE_IRQ_ExchangeMask(mask); }
/* The fixture supplies stop policy; the standalone reader supplies decoding. */
int pe_plat_pump_load_existing(uint32_t index, uint32_t offset, uint32_t *out)
{
    if (!PE_GpuQueue_ReadWord(index, offset, out)) abort();
    return 1;
}
int pe_plat_pump_worker_existing(pe_addr_t worker, pe_addr_t arg, uint32_t aux, uint32_t consumer)
{
    uint32_t expected = worker_calls == 0 ? 63u : 0u;
    if (worker_calls >= 2 || consumer != expected ||
        worker != 0x8017f000u + expected || arg != 0x8017f100u + expected ||
        aux != 0x12345600u + expected || PE_IRQ_GetMask() != 0 ||
        PE_GPU_DMA2CompletionPending()) abort();
    worker_calls++;
    return 1;
}
int pe_plat_pump_drawsync_existing(pe_addr_t callback) { (void)callback; abort(); }
const PeGuestCodeEntry *PE_GuestCode_Resolve(pe_addr_t address) { (void)address; abort(); }
void func_8007C13C(void) { abort(); }
void func_8007C214(void) { abort(); }
void func_801214D4(void) { abort(); }
void func_80191DC8(void) { abort(); }
int PE_GuestHook_Call(const char *slot, const char *caller, pe_addr_t fn,
                      unsigned arity, uintptr_t a0, uintptr_t a1,
                      uintptr_t a2, uintptr_t a3, int *ret)
{
    (void)caller; (void)a1; (void)a2; (void)a3; (void)ret;
    if (strcmp(slot,"func_80074520_dma_indirect_call") || fn != 0x8017f000u ||
        arity != 0 || a0 != 0x1f8010f4u || PE_GPU_DMA2CompletionPending() ||
        (PE_IRQ_ReadStatus() & 8u)) abort();
    dma_callback_calls++;
    return 1;
}
void PE_GuestHook_Refuse(const char *slot, const char *caller, pe_addr_t fn,
                         unsigned arity, uintptr_t a0, uintptr_t a1,
                         uintptr_t a2, uintptr_t a3, const char *why)
{ (void)slot;(void)caller;(void)fn;(void)arity;(void)a0;(void)a1;(void)a2;(void)a3;(void)why;abort(); }
void PE_Port_RequestStop(PEPortStopReason r) { (void)r; abort(); }
void Bootstrap_ReturnVoid1(const char *a,const char *b,uint32_t c) { (void)a;(void)b;(void)c;abort(); }
void Trace_Direct(const char *s) { (void)s; }
/* Run the clean-room DMA interrupt handler (func_80074520 = pe_plat_dma_handler)
 * and classify the pass by the stop epoch. */
static PeIrqServiceResult dma_handler_verdict(void)
{
    unsigned epoch = PE_Port_StopEpoch();
    (void)func_80074520();
    return PE_Port_StopEpoch() == epoch ? PE_IRQ_SERVICE_RETURNED : PE_IRQ_SERVICE_BOUNDARY;
}
static unsigned normal_calls, projections, geometry;
uint32_t __real_pe_plat_gte_vector_normal(uint32_t, uint32_t);
uint32_t __wrap_pe_plat_gte_vector_normal(uint32_t in, uint32_t out)
{
    normal_calls++;
    uint32_t sum = __real_pe_plat_gte_vector_normal(in, out);
    if (sum != 16777216u || PE_LoadU32(out) != 0 ||
        PE_LoadU32(out+4) != 0 || PE_LoadU32(out+8) != 4096) abort();
    return sum;
}
void __real_pe_plat_gte_set_geom_screen(int);
void __wrap_pe_plat_gte_set_geom_screen(int h) { if (h != 256) abort(); geometry++; __real_pe_plat_gte_set_geom_screen(h); }
int32_t __real_pe_plat_gte_rot_trans_pers(uint32_t,uint32_t,uint32_t,uint32_t);
int32_t __wrap_pe_plat_gte_rot_trans_pers(uint32_t v,uint32_t xy,uint32_t p,uint32_t flag)
{
    projections++;
    int32_t depth=__real_pe_plat_gte_rot_trans_pers(v,xy,p,flag);
    return depth;
}
static void upload(unsigned x,unsigned y,unsigned w,unsigned h,uint16_t value)
{
    if(!PE_GPU_WriteGP0(0xa0000000u) || !PE_GPU_WriteGP0((y<<16)|x) ||
       !PE_GPU_WriteGP0((h<<16)|w)) abort();
    uint32_t pair=(uint32_t)value|((uint32_t)value<<16);
    for(unsigned i=0;i<(w*h+1u)/2u;i++) if(!PE_GPU_WriteGP0(pair)) abort();
}
static uint16_t pixel(unsigned x,unsigned y)
{
    uint16_t v; if(!PE_GPU_ReadVRAM(x,y,&v)) abort(); return v;
}
extern int32_t func_80068014(pe_addr_t);
static void run(int nonzero,int transparent)
{
    PE_RamReset(); PE_GPU_Init(); PE_IRQ_Reset(); PE_IRQ_DeliveryTraceReset();
    PeIrqGeneration generation=PE_IRQ_Generation();
    memset(&g_pe_gte,0,sizeof g_pe_gte);
    normal_calls = projections = geometry = dma_callback_calls = pump_entries = worker_calls = 0;
    pump_order = 0;
    memset(&pump_trace, 0, sizeof pump_trace);
    PE_StoreU32(0x801401b4u,0x80141000u); PE_StoreU16(0x80141014u,16);
    PE_StoreU8(0x80140252u,1); PE_StoreU32(0x80140238u,0x80142000u);
    PE_StoreU16(0x8014002eu,64); PE_StoreU32(0x80140278u,0x80145000u);
    PE_StoreU8(0x8014027du,128);
    for (unsigned i=0;i<9;i++) {
        PE_StoreU16(0x80142000u+2*i,(i==0||i==4||(i==8&&nonzero))?4096:0);
        PE_StoreU16(0x800b89f8u+2*i,(i==0||i==4||i==8)?4096:0);
    }
    /* Invented constant values, not the game's table. */
    for (unsigned i=0;i<256;i++) PE_StoreU16(0x800961d0u+2*i,4096);
    PE_StoreU32(0x80142014u,80); PE_StoreU32(0x8014201cu,13);
    PE_StoreU32(0x800b8a14u,512); PE_StoreU32(0x800b8a18u,256);
    PE_StoreU32(0x800b0e38u,0x80146000u);
    for(unsigned i=0;i<4096;i++) PE_StoreU32(0x80146000u+4*i,0xaabbccddu);
    PE_GPU_WriteDPCR(PE_GPU_ReadDPCR() | 0x08000000u);
    if(!PE_GPU_WriteDMA6Register(0,0x0014621cu) ||
       !PE_GPU_WriteDMA6Register(4,136u) ||
       !PE_GPU_WriteDMA6Register(8,0x11000002u)) abort();
    PeGpuState cleared; PE_GPU_GetState(&cleared);
    if(cleared.dma6_event_count!=1 || PE_LoadU32(0x80146000u)!=0x00ffffffu ||
       PE_LoadU32(0x8014621cu)!=0x00146218u) abort();
    for (unsigned i=0;i<40;i++) PE_StoreU8(0x80145000u+i,0x5a);
    for (unsigned i=0;i<64;i++) PE_StoreU8(0x1f800340u+i,(uint8_t)i);
    if (func_80068014(0x80140000u) || geometry!=1 || projections!=4 ||
        normal_calls!=(unsigned)nonzero) abort();
    if(!PE_GPU_WriteGP0(0xe3000000u) || !PE_GPU_WriteGP0(0xe407ffffu)) abort();
    upload(0,0,100,100,0x7fff);
    upload(704,64,32,64,0x0101);
    upload(257,456,1,1,transparent?0u:0xffffu);
    if(pixel(5,5)!=0x7fff || pixel(704,64)!=0x0101 ||
       pixel(257,456)!=(transparent?0u:0xffffu)) abort();
    if(PE_LoadU32(0x80145000u)!=0x09146218u ||
       PE_LoadU32(0x8014621cu)!=0x00145000u) abort();
    if(!PE_GPU_WriteGP1(0x04000002u)) abort();
    PE_GPU_EnableDMA2(); PE_GPU_SetDMA2InterruptEnabled(1);
    if(!PE_GPU_WriteDMA2Register(0,0x0014621cu) ||
       !PE_GPU_WriteDMA2Register(8,PE_GPU_DMA2_CHCR_LIST) || !PE_GPU_DMA2Pending()) abort();
    uint64_t token=PE_GPU_DMA2EventToken();
    if(!token || PE_GPU_ServiceDMA2Completion(token+1u) || pixel(30,30)!=0x7fffu) abort();
    if(PE_GPU_ServiceDMA2Completion(token) || !PE_GPU_DMA2Pending() ||
       PE_GPU_ReadDMA2MADR()!=0x00145000u || pixel(30,30)!=0x7fffu) abort();
    if(PE_GPU_ServiceDMA2Completion(token) || !PE_GPU_DMA2Pending() ||
       PE_GPU_ReadDMA2MADR()!=0x00146218u) abort();
    for(unsigned i=0;i<135;i++) {
        int done=PE_GPU_ServiceDMA2Completion(token);
        if(done!=(i==134) || PE_GPU_DMA2Pending()!=(i!=134)) abort();
    }
    if(PE_GPU_ReadDMA2MADR()!=0x00ffffffu) abort();
    if(!PE_GPU_DMA2CompletionPending() || !PE_GPU_DICRRisingEdgePending()) abort();
    if(PE_IRQ_BridgeDICRRisingEdge(generation-1u)!=PE_IRQ_EDGE_STALE ||
       !PE_GPU_DICRRisingEdgePending() || PE_IRQ_ReadStatus()!=0) abort();
    if(PE_IRQ_BridgeDICRRisingEdge(generation)!=PE_IRQ_EDGE_ASSERTED ||
       !(PE_IRQ_ReadStatus()&8u) || PE_GPU_DICRRisingEdgePending() ||
       PE_IRQ_BridgeDICRRisingEdge(generation)!=PE_IRQ_EDGE_NONE) abort();
    PE_StoreU16(0x800945e4u,1); /* synthetic initialized controller */
    PE_StoreU16(0x80094614u,8); /* synthetic enabled-source shadow */
    PE_StoreU32(0x800945f4u,0x80074520u); /* synthetic native DMA handler */
    PE_StoreU32(0x800956bcu,0x1f8010f4u);
    PE_StoreU32(0x800956c8u,0x80076ee4u); /* native GPU queue pump */
    PE_StoreU32(0x80095874u,1); /* synthetic entries 63 and 0 */
    PE_StoreU32(0x80095878u,63);
    for (unsigned n=0; n<2; n++) {
        uint32_t i = n ? 0u : 63u;
        uint32_t entry = 0x800bd030u + i * 0x60u;
        PE_StoreU32(entry, 0x8017f000u + i);
        PE_StoreU32(entry+4, 0x8017f100u + i);
        PE_StoreU32(entry+8, 0x12345600u + i);
        PE_StoreU32(entry+12, 0xcafebabeu + i);
    }
    PE_StoreU32(0x80095758u,0x8017f200u); /* avoid callback removal */
    PE_IRQ_ExchangeMask(8u);
    if(PE_IRQ_ServicePendingForGeneration(generation-1u)!=PE_IRQ_SERVICE_STALE ||
       !(PE_IRQ_ReadStatus()&8u)) abort();
    if(PE_IRQ_ServicePendingForGeneration(generation)!=PE_IRQ_SERVICE_RETURNED ||
       (PE_IRQ_ReadStatus()&8u) || PE_GPU_DMA2CompletionPending()) abort();
    PeIrqDeliveryTrace trace; PE_IRQ_GetDeliveryTrace(&trace);
    if(trace.cpu_ack_count!=1 || trace.last_cpu_source!=3 ||
       trace.last_cpu_handler!=0x80074520u || trace.dma_ack_count!=1 ||
       trace.last_dma_channel!=2 || trace.dma_dispatch_entries!=1 || dma_callback_calls!=0 || pump_entries!=1 || worker_calls!=2 ||
       !(trace.cpu_ack_order < trace.cpu_callback_order &&
         trace.cpu_callback_order < trace.dma_ack_order &&
         trace.dma_ack_order < trace.dma_callback_order)) abort();
    if (PE_LoadU32(0x80095878u)!=1 || PE_IRQ_GetMask()!=8 ||
        pump_trace.saved_mask!=8 || pump_trace.restored_mask!=8 ||
        !(pump_trace.mask_disable_order < pump_trace.gpustat_ready_order &&
          pump_trace.gpustat_ready_order < pump_trace.consumer_advance_order &&
          pump_trace.consumer_advance_order < pump_trace.mask_restore_order)) abort();
    if (PE_LoadU32(0x800bd030u+12)!=0xcafebabeu ||
        PE_LoadU32(0x800bd030u+63u*0x60u+12)!=0xcafebafdu) abort();
    /* Re-entering the handler with no pending flag must not invoke it again. */
    if (dma_handler_verdict()!=PE_IRQ_SERVICE_RETURNED || pump_entries!=1 || worker_calls!=2) abort();
    PE_GPU_AcknowledgeDMA2Interrupt();
    if(PE_GPU_DMA2CompletionPending() || (PE_IRQ_ReadStatus()&8u)) abort();
    PE_IRQ_WriteStatus((uint16_t)~8u);
    if(PE_IRQ_ReadStatus()&8u) abort();
    unsigned changed=0;
    for(unsigned y=0;y<100;y++) for(unsigned x=0;x<100;x++) if(pixel(x,y)!=0x7fff) changed++;
    if(changed!=(transparent?0u:31u)) abort();
    if(pixel(30,30)!=(transparent?0x7fffu:0xc210u) || pixel(20,20)!=0x7fffu) abort();
    PeGpuState state; PE_GPU_GetState(&state);
    if(state.polygon_count!=1u || state.gp0_state!=PE_GPU_GP0_IDLE) abort();
    printf("DMA ring wrap facing=%d transparent=%d changed=%u\n",nonzero,transparent,changed);
    for (unsigned i=0;i<64;i++) if (PE_LoadU8(0x1f800340u+i)!=(uint8_t)i) abort();
}
static void test_ring_reader(void)
{
    uint32_t out = 0;
    PE_RamReset();
    PE_StoreU32(0x800bd030u, 0x10203040u);
    PE_StoreU32(0x800bd030u + 64u * 0x60u, 0x55667788u);
    PE_StoreU32(0x800bd030u - 0x60u, 0xaabbccddu);
    if (!PE_GpuQueue_ReadWord(0, 0, &out) || out != 0x10203040u ||
        !PE_GpuQueue_ReadWord(64, 0, &out) || out != 0x55667788u ||
        !PE_GpuQueue_ReadWord(0x08000000u, 0, &out) || out != 0x10203040u ||
        !PE_GpuQueue_ReadWord(UINT32_MAX, 0, &out) || out != 0xaabbccddu) abort();
    out = 0xdeadbeefu;
    if (PE_GpuQueue_ReadWord(0x10000u, 0, &out) || out != 0xdeadbeefu ||
        PE_GpuQueue_ReadWord(0, 12, &out) || out != 0xdeadbeefu ||
        PE_GpuQueue_ReadWord(0, 0, NULL)) abort();
    puts("queue reader raw-index, wrap and invalid controls passed");
}
int main(void)
{
    test_ring_reader();
    run(0,0); run(1,0); run(1,1); PE_RamDestroy();

    return 0;
}
