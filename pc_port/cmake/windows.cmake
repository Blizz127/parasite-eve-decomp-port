# Windows (WIN32) build settings for pc_port; docs/port/WINDOWS.md.
#
# CMakeLists.txt includes this file once, after every target is defined.  In
# a non-WIN32 build it returns at once and changes nothing.  The supported
# Windows toolchain is the MinGW-w64 GNU ABI; the tested one is zig cc
# (cmake/zig-windows-x86_64.cmake).  MSVC lacks __attribute__((weak)),
# __attribute__((constructor)) and __builtin_return_address, which the
# runtime uses.
if(NOT WIN32)
    return()
endif()
if(MSVC)
    message(WARNING "pe: the Windows port is built and tested with the MinGW-w64 GNU ABI "
                    "(zig cc); MSVC is not supported (weak symbols, GCC builtins)")
endif()

# 1. POSIX gaps, without edits to the shared runtime files.
#    platform/pe_posix_win32.h is force-included into every C target (it maps
#    clock_gettime, two-argument mkdir and backtrace onto pe_posix_win32.c),
#    and the build tree gets an empty <execinfo.h> so the shared
#    `#include <execinfo.h>` (platform/pe_gpu.c) resolves.
set(PE_WIN32_COMPAT_DIR "${CMAKE_BINARY_DIR}/pe-win32-compat")
set(_pe_execinfo "/* Generated by pc_port/cmake/windows.cmake.  backtrace() and\n"
                 " * backtrace_symbols_fd() come from platform/pe_posix_win32.h,\n"
                 " * which every Windows TU force-includes. */\n")
string(CONCAT _pe_execinfo ${_pe_execinfo})
set(_pe_execinfo_old "")
if(EXISTS "${PE_WIN32_COMPAT_DIR}/execinfo.h")
    file(READ "${PE_WIN32_COMPAT_DIR}/execinfo.h" _pe_execinfo_old)
endif()
if(NOT _pe_execinfo_old STREQUAL _pe_execinfo)
    file(WRITE "${PE_WIN32_COMPAT_DIR}/execinfo.h" "${_pe_execinfo}")
endif()
target_sources(pe_field_runtime PRIVATE ${CMAKE_SOURCE_DIR}/platform/pe_posix_win32.c)
get_property(_pe_targets DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY BUILDSYSTEM_TARGETS)
foreach(_pe_t IN LISTS _pe_targets)
    get_target_property(_pe_type ${_pe_t} TYPE)
    if(_pe_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
        target_compile_options(${_pe_t} PRIVATE "SHELL:-include \"${CMAKE_SOURCE_DIR}/platform/pe_posix_win32.h\"")
        target_include_directories(${_pe_t} BEFORE PRIVATE "${PE_WIN32_COMPAT_DIR}")
    endif()
endforeach()

# 2. COFF archive member order.  llvm-ar's symbol index also lists a member's
#    *weak references* (weak externals whose default is absolute 0), and lld
#    resolves a name from the first indexed member.  When a TU that only
#    weakly references a function (platform/plat_cheats.c -> func_80053D2C)
#    is indexed before the TU that defines it, every strong reference binds
#    to the weak default (NULL) and the definition is never extracted; ELF
#    extracts the definition.  Keep the member order but move every runtime
#    TU that declares __attribute__((weak)) to the end, so a definition is
#    indexed first, as ELF would choose.  (Same fix as the 2026-10-02 W1
#    lane, re-implemented here.)
get_target_property(_pe_rt_srcs pe_field_runtime SOURCES)
set(_pe_rt_front "")
set(_pe_rt_weak "")
foreach(_pe_src IN LISTS _pe_rt_srcs)
    if(IS_ABSOLUTE "${_pe_src}")
        set(_pe_path "${_pe_src}")
    else()
        set(_pe_path "${CMAKE_SOURCE_DIR}/${_pe_src}")
    endif()
    set(_pe_weak_lines "")
    if(EXISTS "${_pe_path}")
        file(STRINGS "${_pe_path}" _pe_weak_lines REGEX "__attribute__[ \t]*\\(\\([ \t]*weak")
    endif()
    if(_pe_weak_lines)
        list(APPEND _pe_rt_weak "${_pe_src}")
    else()
        list(APPEND _pe_rt_front "${_pe_src}")
    endif()
endforeach()
set_property(TARGET pe_field_runtime PROPERTY SOURCES ${_pe_rt_front} ${_pe_rt_weak})
list(LENGTH _pe_rt_weak _pe_rt_weak_n)
message(STATUS "pe: WIN32: ${_pe_rt_weak_n} weak-referencing runtime TUs moved to the archive end: ${_pe_rt_weak}")

# 3. The executable's Windows host layer.
#    - host_audio_winmm.c replaces host_audio.c: the same host_audio.h API
#      (WAV dump included) with a WinMM waveOut device instead of PulseAudio.
#    - host_pad_xinput.c is the Windows host_pad.h (XInput, loaded at run
#      time; no controller and no DLL = keyboard only).
#    - host_dev_menu.c (unchanged shared code) gives the dev/Options menu its
#      controller combo; the keyboard opens it with F8 (host_window_win32.c).
get_target_property(_pe_exe_srcs parasite-eve-port SOURCES)
list(TRANSFORM _pe_exe_srcs REPLACE "^platform/host_audio\\.c$" "platform/host_audio_winmm.c")
set_property(TARGET parasite-eve-port PROPERTY SOURCES ${_pe_exe_srcs})
target_sources(parasite-eve-port PRIVATE platform/host_dev_menu.c platform/host_pad_xinput.c)
target_link_libraries(parasite-eve-port PRIVATE winmm)

# 4. The Win32 window backend's unit test links the same host layer.
if(TARGET pe-win32-input-tests)
    target_sources(pe-win32-input-tests PRIVATE platform/host_dev_menu.c
                   platform/host_pad_xinput.c platform/host_audio_winmm.c)
    target_link_libraries(pe-win32-input-tests PRIVATE pe_field_runtime winmm)
endif()
